{
  "standard": {
    "module": 2,
    "grid": 20,
    "level": 10,
    "gear_thickness": 8,
    "bearing": "608 (8 x 22 x 7)",
    "mesh_rule": "two gears mesh when their tooth counts add up to a multiple of 20",
    "profiles": ["PLA", "PETG", "ABS"]
  },
  "parts": [
    { "name": "COUPON", "title": "Fit test coupon", "group": "test", "params": { "part": "coupon" }, "expect": { "size": [60, 52, 12] } },

    { "name": "B4x4",   "title": "Tile 4x4, bayonet", "group": "board", "params": { "part": "tile", "tile_nx": 4, "tile_ny": 4, "socket": "bayonet" }, "expect": { "size": [87.65, 87.65, 12] } },
    { "name": "B4x4-M8", "title": "Tile 4x4, M8 captive nuts", "group": "board", "params": { "part": "tile", "tile_nx": 4, "tile_ny": 4, "socket": "M8" }, "expect": { "size": [87.65, 87.65, 12] } },
    { "name": "B4x4-M6", "title": "Tile 4x4, M6 captive nuts", "group": "board", "params": { "part": "tile", "tile_nx": 4, "tile_ny": 4, "socket": "M6" }, "expect": { "size": [87.65, 87.65, 12] } },
    { "name": "B6x6",   "title": "Tile 6x6, bayonet", "group": "board", "params": { "part": "tile", "tile_nx": 6, "tile_ny": 6, "socket": "bayonet" }, "expect": { "size": [127.65, 127.65, 12] } },

    { "name": "P1", "title": "Pin, 1 level", "group": "pin", "params": { "part": "pin", "levels": 1 }, "expect": { "size": [17, 16, 26.7] } },
    { "name": "P2", "title": "Pin, 2 levels", "group": "pin", "params": { "part": "pin", "levels": 2 }, "expect": { "size": [17, 16, 36.7] } },
    { "name": "P3", "title": "Pin, 3 levels", "group": "pin", "params": { "part": "pin", "levels": 3 }, "expect": { "size": [17, 16, 46.7] } },
    { "name": "C",  "title": "Quarter-turn cap", "group": "pin", "params": { "part": "cap" }, "expect": { "size": [20, 20, 8.2] } },
    { "name": "K8", "title": "Knob for an M8 hex bolt", "group": "hardware", "params": { "part": "knob", "bolt": "M8" }, "expect": { "size": [20, 20, 12.2] } },
    { "name": "K6", "title": "Knob for an M6 hex bolt", "group": "hardware", "params": { "part": "knob", "bolt": "M6" }, "expect": { "size": [20, 20, 10.7] } },
    { "name": "S1", "title": "Spacer, 3 mm (between levels)", "group": "pin", "params": { "part": "spacer", "spacer_h": 3 }, "expect": { "size": [11, 11, 3] } },
    { "name": "S10", "title": "Spacer, 10 mm (skip a level)", "group": "pin", "params": { "part": "spacer", "spacer_h": 10 }, "expect": { "size": [11, 11, 10] } },
    { "name": "S2", "title": "Base spacer for bolt tiles", "group": "hardware", "params": { "part": "base_spacer", "bolt": "M8" }, "expect": { "size": [11, 11, 2] } },
    { "name": "CPL", "title": "Spline coupler", "group": "pin", "params": { "part": "coupler" }, "expect": { "size": [34, 34, 6] } },
    { "name": "SLV6", "title": "M6 sleeve for a 608", "group": "hardware", "params": { "part": "sleeve_m6" }, "expect": { "size": [7.85, 7.85, 7] } },
    { "name": "BSH8", "title": "Plain bushing, M8, replaces a 608", "group": "hardware", "params": { "part": "bushing", "bolt": "M8" }, "expect": { "size": [21.9, 21.9, 7] } },

    { "name": "G20", "title": "Gear 20T", "group": "gear", "params": { "part": "gear", "teeth": 20 }, "expect": { "size": [44, 44, 8] } },
    { "name": "G30", "title": "Gear 30T", "group": "gear", "params": { "part": "gear", "teeth": 30 }, "expect": { "size": [64, 64, 8] } },
    { "name": "G40", "title": "Gear 40T", "group": "gear", "params": { "part": "gear", "teeth": 40, "face": "spokes" }, "expect": { "size": [84, 84, 8] } },
    { "name": "G50", "title": "Gear 50T", "group": "gear", "params": { "part": "gear", "teeth": 50, "face": "spokes" }, "expect": { "size": [104, 104, 8] } },
    { "name": "G60", "title": "Gear 60T", "group": "gear", "params": { "part": "gear", "teeth": 60, "face": "spokes" }, "expect": { "size": [124, 124, 8] } },
    { "name": "G70", "title": "Gear 70T", "group": "gear", "params": { "part": "gear", "teeth": 70, "face": "holes" }, "expect": { "size": [144, 144, 8] } },
    { "name": "G80", "title": "Gear 80T", "group": "gear", "params": { "part": "gear", "teeth": 80, "face": "spokes" }, "expect": { "size": [164, 164, 8] } },
    { "name": "G40-20", "title": "Compound 40T over 20T", "group": "gear", "params": { "part": "compound", "teeth": 40, "teeth_upper": 20 }, "expect": { "size": [84, 84, 17] } },
    { "name": "G60-20", "title": "Compound 60T over 20T", "group": "gear", "params": { "part": "compound", "teeth": 60, "teeth_upper": 20, "face": "spokes" }, "expect": { "size": [124, 124, 17] } },
    { "name": "G80-20", "title": "Compound 80T over 20T", "group": "gear", "params": { "part": "compound", "teeth": 80, "teeth_upper": 20, "face": "spokes" }, "expect": { "size": [164, 164, 17] } },
    { "name": "G60-40", "title": "Compound 60T over 40T", "group": "gear", "params": { "part": "compound", "teeth": 60, "teeth_upper": 40, "face": "spokes" }, "expect": { "size": [124, 124, 17] } }
  ],
  "kits": {
    "coupon": ["COUPON", "P1", "C", "CPL"],
    "starter-bayonet": ["B4x4", "P1", "P1", "P1", "P2", "C", "C", "C", "C", "S1", "G20", "G20", "G40", "G60", "CPL"],
    "starter-m8": ["B4x4-M8", "K8", "K8", "K8", "K8", "S2", "S2", "S2", "S2", "S1", "G20", "G20", "G40", "G60", "CPL"]
  }
}
